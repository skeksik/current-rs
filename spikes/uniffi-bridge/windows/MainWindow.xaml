<Window
    x:Class="BridgeSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BridgeSpike.ViewModels"
    Title="Bridge spike">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Observable value" />
            <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind Value.Count, Mode=OneWay}" />
            <TextBlock TextWrapping="Wrap" Text="{x:Bind Value.Threads, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Increment" Click="{x:Bind Value.Increment}" />
                <Button Content="Start ticker" Click="{x:Bind Value.StartTicker}" />
                <Button Content="Stop ticker" Click="{x:Bind Value.StopTicker}" />
                <ToggleSwitch x:Name="SubscribedSwitch" Header="Subscribed" IsOn="True" Toggled="OnSubscribedToggled" />
            </StackPanel>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Observable list (diffs)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Step" Click="{x:Bind Items.Step}" />
                <Button Content="Start feed" Click="{x:Bind Items.StartFeed}" />
                <Button Content="Stop feed" Click="{x:Bind Items.StopFeed}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Items.Batches, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="batches applied" />
            </StackPanel>
            <ListView Height="240" ItemsSource="{x:Bind Items.Rows}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemRow">
                        <TextBlock Text="{x:Bind Title}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Async call with cancellation" />
            <TextBox Header="Text to reverse (3 s)" Text="{x:Bind Operation.Input, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Content="Run" Click="{x:Bind Operation.Run}" />
                <Button Content="Cancel" Click="{x:Bind Operation.Cancel}" IsEnabled="{x:Bind Operation.IsRunning, Mode=OneWay}" />
                <Button Content="Run with empty text" Click="{x:Bind Operation.RunEmpty}" />
                <Button Content="Run and abandon" Click="{x:Bind Operation.RunAndAbandon}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{x:Bind Operation.Result, Mode=OneWay}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind Operation.CoreState, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Window>
