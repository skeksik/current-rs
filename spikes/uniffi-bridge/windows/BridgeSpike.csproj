<Project Sdk="Microsoft.NET.Sdk">
  <!-- D1 spike (docs/notes/uniffi-bridge.md). Unpackaged, self-contained WinUI 3 app over the Rust bridge. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BridgeSpike</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated bindings use unsafe code for RustBuffer access. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Where the release build of the Rust crate puts bridge_spike.dll; CI passes it explicitly. -->
    <BridgeLibDir Condition="'$(BridgeLibDir)' == ''">$(MSBuildThisFileDirectory)..\target\release</BridgeLibDir>
    <!-- A separate property: one passed with -p: is global and cannot be changed here. -->
    <BridgeLib>$([MSBuild]::EnsureTrailingSlash('$(BridgeLibDir)'))</BridgeLib>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated/bridge_spike.cs (from uniffi-bindgen-cs, not checked in) is picked up by the SDK's default glob. -->
    <None Include="$(BridgeLib)bridge_spike.dll" Link="bridge_spike.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckBridgeInputs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('Generated\bridge_spike.cs')" Text="Generate the C# bindings first (docs/notes/uniffi-bridge.md)." />
    <Error Condition="!Exists('$(BridgeLib)bridge_spike.dll')" Text="Build bridge_spike.dll first: cargo build --release in spikes/uniffi-bridge." />
  </Target>
</Project>
