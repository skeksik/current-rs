<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VideoSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VideoSpike"
    Title="Current video spike">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the system draws the caption buttons; this area drags, snaps and double-click maximizes. -->
        <Grid x:Name="AppTitleBar" Height="48">
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="Current video spike" />
        </Grid>

        <Grid x:Name="Toolbar" Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Click="Open_Click" AutomationProperties.Name="Open file">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Open file" />
                </StackPanel>
            </Button>
            <TextBox x:Name="UrlBox" Grid.Column="1" PlaceholderText="Direct-play URL (not saved anywhere)"
                     AutomationProperties.Name="Direct-play URL" KeyDown="UrlBox_KeyDown" />
            <Button Grid.Column="2" Content="Play URL" Click="PlayUrl_Click" />
            <DropDownButton x:Name="ColourButton" Grid.Column="3" Content="Colour: auto" AutomationProperties.Name="Colour output mode">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <RadioMenuFlyoutItem Text="Auto (follow the display)" GroupName="colour" Tag="auto" IsChecked="True" Click="Colour_Click" />
                        <RadioMenuFlyoutItem Text="HDR passthrough (source metadata)" GroupName="colour" Tag="source" Click="Colour_Click" />
                        <RadioMenuFlyoutItem Text="scRGB (FP16)" GroupName="colour" Tag="scrgb" Click="Colour_Click" />
                        <RadioMenuFlyoutItem Text="Force SDR (no colour space hint)" GroupName="colour" Tag="sdr" Click="Colour_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button x:Name="MeasureButton" Grid.Column="4" Content="Measure 60 s" Click="Measure_Click" />
            <ToggleButton x:Name="InfoToggle" Grid.Column="5" Content="Info" IsChecked="True" Click="InfoToggle_Click" />
        </Grid>

        <Grid x:Name="Player" Grid.Row="2" Background="Black" PointerMoved="Player_PointerMoved"
              PointerPressed="Player_PointerMoved" DoubleTapped="Player_DoubleTapped">
            <SwapChainPanel x:Name="VideoPanel" SizeChanged="VideoPanel_SizeChanged"
                            CompositionScaleChanged="VideoPanel_CompositionScaleChanged" />

            <Border x:Name="InfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,8"
                    CornerRadius="{StaticResource OverlayCornerRadius}" Background="#B0000000" IsHitTestVisible="False">
                <TextBlock x:Name="InfoText" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="White"
                           TextWrapping="NoWrap" />
            </Border>

            <!-- Our own transport controls over the video (ADR 0001). -->
            <Border x:Name="Controls" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="1100"
                    Margin="24,0,24,24" Padding="16,8,16,12" CornerRadius="{StaticResource OverlayCornerRadius}"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                    PointerEntered="Controls_PointerEntered" PointerExited="Controls_PointerExited">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionText" VerticalAlignment="Center" Text="0:00"
                                   Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.Name="Position" />
                        <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.1"
                                SmallChange="5" LargeChange="30" IsThumbToolTipEnabled="True"
                                AutomationProperties.Name="Seek" ValueChanged="SeekBar_ValueChanged" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" Text="0:00"
                                   Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.Name="Duration" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="BackButton" Style="{StaticResource SubtleButtonStyle}" Click="Back_Click"
                                    AutomationProperties.Name="Back 10 seconds" ToolTipService.ToolTip="Back 10 seconds (Left)">
                                <FontIcon Glyph="&#xEB9E;" FontSize="16" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource SubtleButtonStyle}" Click="PlayPause_Click"
                                    AutomationProperties.Name="Play" ToolTipService.ToolTip="Play (Space)">
                                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                            </Button>
                            <Button x:Name="ForwardButton" Style="{StaticResource SubtleButtonStyle}" Click="Forward_Click"
                                    AutomationProperties.Name="Forward 30 seconds" ToolTipService.ToolTip="Forward 30 seconds (Right)">
                                <FontIcon Glyph="&#xEB9D;" FontSize="16" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <DropDownButton x:Name="AudioButton"
                                            AutomationProperties.Name="Audio track" ToolTipService.ToolTip="Audio track">
                                <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="AudioMenu" Placement="Top" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton x:Name="SubtitleButton"
                                            AutomationProperties.Name="Subtitles" ToolTipService.ToolTip="Subtitles">
                                <FontIcon Glyph="&#xE7F0;" FontSize="16" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="SubtitleMenu" Placement="Top" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="FullScreenButton" Style="{StaticResource SubtleButtonStyle}" Click="FullScreen_Click"
                                    AutomationProperties.Name="Full screen" ToolTipService.ToolTip="Full screen (F11)">
                                <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
