<Page
    x:Class="Current.Shell.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource WidePageTitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <!-- How many items the library holds, as File Explorer's status bar counts a folder's items. -->
            <TextBlock
                x:Name="CountText"
                Margin="24,4,24,0"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Sort and show: the core's ItemQuery takes both; a new choice is a new query, which starts at the top (ADR 0018, section
             3). Refresh re-reads the grid in place. F5 and Ctrl+R for it are what File Explorer and Edge use; no Microsoft guideline read so
             far states it (not verified). -->
        <StackPanel Grid.Row="1" Margin="24,12,24,0" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="SortBox" Header="Sort by" SelectionChanged="OnQueryChanged">
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Date added" />
                <ComboBoxItem Content="Release date" />
                <ComboBoxItem Content="Rating" />
            </ComboBox>
            <ComboBox x:Name="FilterBox" Header="Show" SelectionChanged="OnQueryChanged">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Unplayed" />
                <ComboBoxItem Content="Played" />
                <ComboBoxItem Content="Favourites" />
            </ComboBox>
            <Button
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Refresh"
                ToolTipService.ToolTip="Refresh (F5)"
                Click="OnRefresh">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
        </StackPanel>

        <InfoBar x:Name="StateInfo" Grid.Row="2" Margin="24,12,24,0" IsClosable="False" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Content="Retry" Click="OnRetry" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ProgressRing x:Name="LoadingRing" Grid.Row="3" Width="48" Height="48" IsActive="False" AutomationProperties.Name="Loading" />
        <TextBlock
            x:Name="EmptyText"
            Grid.Row="3"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="Nothing to show here." />

        <!-- The grid fills the page; its padding keeps the page margin while the scroll bar stays at the window's edge. The right
             padding is 4 less than the margin: each item already has 4 on its right (GridViewItem's default Margin 0,0,4,4,
             GridViewItem_themeresources.xaml, microsoft-ui-xaml main, read 2026-10-25), which is kept, not overridden. -->
        <GridView
            x:Name="Items"
            Grid.Row="3"
            Padding="24,12,20,24"
            ItemTemplate="{StaticResource PosterTileTemplate}"
            AutomationProperties.Name="Items" />
    </Grid>
</Page>
