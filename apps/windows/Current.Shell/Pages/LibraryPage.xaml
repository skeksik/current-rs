<Page
    x:Class="Current.Shell.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- F5 and Ctrl+R re-read the grid in place, as File Explorer and Edge do; no Microsoft guideline read so far states it (not
             verified). The Refresh button is gone (owner, 2026-10-26); the keys stay. -->
        <!-- Ctrl+F goes to the library's search box: "Find content in a focused control or Window | Ctrl + F" (Keyboard
             accelerators page, learn.microsoft.com, ms.date 2026-08-28, read 2026-10-26). -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefresh" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefresh" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- The title with Sort and Filter on its right, as Photos lays out its gallery's title and commands (owner, 2026-10-26). -->
        <Grid Margin="24,24,24,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                Margin="0"
                Style="{StaticResource WidePageTitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level1" />
            <!-- Sort, Filter and View as File Explorer's command bar has them (owner, 2026-10-26): an icon button with a menu of radio
                 items, the sort's fields and its order in two groups. The core's ItemQuery takes both; a new choice is a new query,
                 which starts at the top (ADR 0018, section 3). The items are the core's choices, named and given icons in
                 LibraryPage.xaml.cs. View switches the tiles between posters and wide pictures, with or without their titles (owner,
                 2026-10-26), as Photos' View menu switches its layout. Glyphs: Segoe Fluent Icons E8CB "Sort", E71C "Filter", F0E2
                 "GridView", E7C3 "Page", EF6B "LandscapeOrientation" and E8BA "Caption" ("Segoe Fluent Icons font",
                 learn.microsoft.com, ms.date 2026-10-13, read 2026-10-26). -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <!-- The library's own search, beside its commands; the title bar's box searches everything (owner, 2026-10-26). It
                     searches as the user types, a moment after the last key, or at once on Enter; the server finds the items (the
                     core's library_search). 240 wide is not from a guideline (not verified). -->
                <AutoSuggestBox
                    x:Name="LibrarySearch"
                    Width="240"
                    QueryIcon="Find"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchSubmitted" />
                <DropDownButton x:Name="SortButton" AutomationProperties.Name="Sort" ToolTipService.ToolTip="Sort">
                    <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="FilterButton" AutomationProperties.Name="Filter" ToolTipService.ToolTip="Filter">
                    <FontIcon Glyph="&#xE71C;" FontSize="16" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="FilterMenu" Placement="BottomEdgeAlignedRight" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="ViewButton" AutomationProperties.Name="View" ToolTipService.ToolTip="View">
                    <FontIcon Glyph="&#xF0E2;" FontSize="16" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="PosterItem" Text="Posters" GroupName="shape" Click="OnViewChosen">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C3;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="WideItem" Text="Wide" GroupName="shape" Click="OnViewChosen">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEF6B;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="TitlesItem" Text="Show titles" Click="OnViewChosen">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8BA;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- How many items the library holds, as File Explorer's status bar counts a folder's items. -->
        <TextBlock
            x:Name="CountText"
            Grid.Row="1"
            Margin="24,4,24,0"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <InfoBar x:Name="StateInfo" Grid.Row="2" Margin="24,12,24,0" IsClosable="False" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Content="Retry" Click="OnRetry" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ProgressRing x:Name="LoadingRing" Grid.Row="3" Width="48" Height="48" IsActive="False" AutomationProperties.Name="Loading" />
        <TextBlock
            x:Name="EmptyText"
            Grid.Row="3"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="Nothing to show here." />

        <!-- The grid fills the page; its padding keeps the page margin while the scroll bar stays at the window's edge. The right
             padding is 4 less than the margin: each item already has 4 on its right (GridViewItem's default Margin 0,0,4,4,
             GridViewItem_themeresources.xaml, microsoft-ui-xaml main, read 2026-10-25), which is kept, not overridden. -->
        <GridView
            x:Name="Items"
            Grid.Row="3"
            Padding="24,12,20,24"
            ItemTemplate="{StaticResource PosterTileTemplate}"
            AutomationProperties.Name="Items" />
    </Grid>
</Page>
