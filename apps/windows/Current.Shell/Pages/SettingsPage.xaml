<Page
    x:Class="Current.Shell.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Current.Shell.ViewModels">
    <!-- Microsoft's settings layout: one scrollable column of about 1000 px, BodyStrong section headers, SettingsCard and
         SettingsExpander, "About" last ("Guidelines for app settings", learn.microsoft.com, ms.date 2026-04-08, read 2026-10-23). The
         title and the column are centred together, as on every page (App.xaml, PageMaxWidth). The first section header has no top
         margin, so it sits as far below the title as every page's first item. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Settings" />
        <ScrollViewer Grid.Row="1">
            <Border>
                <Grid Style="{StaticResource PageColumnStyle}">
                    <StackPanel Spacing="4">
                        <!-- Personalization first, as the WinUI Gallery's settings page puts "Appearance & behavior" before About
                             (WinUIGallery/Pages/SettingsPage.xaml, github.com/microsoft/WinUI-Gallery, main, read 2026-10-24) and as the
                             owner's example, Photos, names it (owner, 2026-10-24). The guideline: "present these options using a combo box
                             inside a SettingsCard" ("Guidelines for app settings", learn.microsoft.com, ms.date 2026-04-08, read
                             2026-10-24). Header and description as the WinUI Gallery's card ("App theme", "Select which app theme to
                             display"). Labels as Photos: Light, Dark, Windows default (owner, 2026-10-24). The guideline's third label is
                             "Use system setting" (same page), as the WinUI Gallery's (Task Manager's too, per the manager; not verified);
                             the owner chose Photos'. The
                             combo applies a choice at once and the core saves it: "When a user changes a setting, the app should
                             immediately reflect the change" (same page). The card's palette icon is Photos' (owner, 2026-10-24): Segoe
                             Fluent Icons E790 "Color" ("Segoe Fluent Icons font", learn.microsoft.com, ms.date 2026-10-13, read 2026-10-24),
                             a FontIcon in the font and size SettingsCard gives it. -->
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Margin="0,0,0,4"
                            AutomationProperties.HeadingLevel="Level2"
                            Text="Personalization" />
                        <toolkit:SettingsCard
                            Header="App theme"
                            Description="Select which app theme to display"
                            AutomationProperties.Name="App theme">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="ThemeBox"
                                AutomationProperties.Name="App theme"
                                IsEnabled="False"
                                SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Windows default" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <InfoBar x:Name="ThemeInfo" Margin="0,8,0,0" IsOpen="False" />

                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Margin="0,24,0,4"
                            AutomationProperties.HeadingLevel="Level2"
                            Text="Accounts" />
                        <toolkit:SettingsCard
                            Header="No servers are set up."
                            Visibility="{x:Bind Servers.EmptyVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                            <Button x:Name="AddFirstServerButton" Content="Add a server" Click="OnAddServer" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            Header="Couldn't refresh the server list."
                            Visibility="{x:Bind Servers.FaultedVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                            <Button Content="Reload" Click="OnReload" />
                        </toolkit:SettingsCard>
                        <ItemsControl
                            IsTabStop="False"
                            ItemsSource="{x:Bind Servers.Rows, Mode=OneWay}"
                            Visibility="{x:Bind Servers.ListVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerRow">
                                    <!-- An expander per server, Remove inside it, as Windows Settings removes an account: "Under Other users,
                                         select the flyout for the account you want to remove. Next to Account and data, select Remove." ("Manage
                                         User Accounts in Windows", support.microsoft.com, read 2026-10-23). -->
                                    <toolkit:SettingsExpander Margin="0,0,0,4" Header="{x:Bind Name, Mode=OneWay}">
                                        <toolkit:SettingsExpander.Description>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Account, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind Product, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind Connection, Mode=OneWay}" />
                                            </StackPanel>
                                        </toolkit:SettingsExpander.Description>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <!-- The gateway in front of the address wants a sign-in again (ADR 0017): the session is kept. -->
                                            <Button
                                                Style="{StaticResource AccentButtonStyle}"
                                                Content="Sign in to the gateway"
                                                AutomationProperties.Name="{x:Bind GatewaySignInLabel, Mode=OneWay}"
                                                Visibility="{x:Bind GatewaySignInVisibility, Mode=OneWay}"
                                                IsEnabled="{x:Bind Idle, Mode=OneWay}"
                                                Click="OnSignInToGateway" />
                                            <Grid>
                                            <Button
                                                Content="Sign out"
                                                AutomationProperties.Name="{x:Bind SignOutLabel, Mode=OneWay}"
                                                Visibility="{x:Bind SignOutVisibility, Mode=OneWay}"
                                                IsEnabled="{x:Bind Idle, Mode=OneWay}"
                                                Click="OnSignOut" />
                                            <Button
                                                Content="Sign in"
                                                AutomationProperties.Name="{x:Bind SignInLabel, Mode=OneWay}"
                                                Visibility="{x:Bind SignInVisibility, Mode=OneWay}"
                                                IsEnabled="{x:Bind Idle, Mode=OneWay}"
                                                Click="OnSignInAgain" />
                                            </Grid>
                                        </StackPanel>
                                        <toolkit:SettingsExpander.Items>
                                            <!-- Extra headers (ADR 0017, "Mechanism 3"): advanced, shown only on request, with a short explanation. -->
                                            <toolkit:SettingsCard
                                                Header="Advanced: extra headers"
                                                Description="For a gateway that lets apps through with a secret header, such as a service token, instead of a sign-in.">
                                                <Button
                                                    Content="Edit headers"
                                                    Tag="{x:Bind Self}"
                                                    AutomationProperties.Name="{x:Bind HeadersLabel, Mode=OneWay}"
                                                    IsEnabled="{x:Bind Idle, Mode=OneWay}"
                                                    Click="OnEditHeaders" />
                                            </toolkit:SettingsCard>
                                            <toolkit:SettingsCard
                                                Header="Remove this server"
                                                Description="Signs out every user here and forgets the server's addresses on this PC.">
                                                <!-- The row travels in Tag: the expander's items need not inherit the template's DataContext. -->
                                                <Button
                                                    Content="Remove"
                                                    Tag="{x:Bind Self}"
                                                    AutomationProperties.Name="{x:Bind RemoveLabel, Mode=OneWay}"
                                                    IsEnabled="{x:Bind Idle, Mode=OneWay}"
                                                    Click="OnRemove" />
                                            </toolkit:SettingsCard>
                                        </toolkit:SettingsExpander.Items>
                                    </toolkit:SettingsExpander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            x:Name="AddAnotherServerButton"
                            Margin="0,4,0,0"
                            Content="Add another server"
                            Visibility="{x:Bind Servers.ListVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                            Click="OnAddServer" />
                        <InfoBar x:Name="AccountsInfo" Margin="0,8,0,0" IsOpen="False" />

                        <!-- Storage (ADR 0018, owner's choice 4): the image cache's size, every server's images together, and Clear,
                             a pattern like Windows' own storage settings (how Windows Settings words it was not verified). Images load
                             again from the servers afterwards; signing out of a server deletes its images by itself. -->
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Margin="0,24,0,4"
                            AutomationProperties.HeadingLevel="Level2"
                            Text="Storage" />
                        <toolkit:SettingsCard x:Name="ImageCacheCard" Header="Image cache" Description="Calculating size…">
                            <Button x:Name="ClearCacheButton" Content="Clear" AutomationProperties.Name="Clear the image cache" Click="OnClearCache" />
                        </toolkit:SettingsCard>
                        <InfoBar x:Name="StorageInfo" Margin="0,8,0,0" IsOpen="False" />

                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Margin="0,24,0,4"
                            AutomationProperties.HeadingLevel="Level2"
                            Text="Diagnostics" />
                        <toolkit:SettingsCard
                            Header="Request log"
                            Description="Recent server requests for a bug report, without server addresses or query values.">
                            <Button Content="Copy diagnostics" Click="OnCopyDiagnostics" />
                        </toolkit:SettingsCard>
                        <InfoBar x:Name="CopiedInfo" Margin="0,8,0,0" IsOpen="False" />

                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Margin="0,24,0,4"
                            AutomationProperties.HeadingLevel="Level2"
                            Text="About" />
                        <toolkit:SettingsExpander Header="Current" Description="{x:Bind VersionText}">
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard Header="© 2026 Skeksik. All rights reserved." />
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
