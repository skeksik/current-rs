<Page
    x:Class="Current.Shell.Pages.SupportedFormatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Current.Shell.Pages">
    <!-- Settings > Supported formats (ADR 0021, owner's decisions 2026-10-26): a page inside Settings, as Windows Settings opens a nested
         page, with a breadcrumb for its title and Back to Settings. The core builds every row; this page only renders them. Layout as
         Settings': the title and one column of PageMaxWidth, centred (App.xaml). -->
    <Page.Resources>
        <!-- The rows' padding: Microsoft gives none for a table like this (none found in its design pages, read 2026-10-26), so 12 before
             the text and 8 above and below, multiples of 4 ("Screen sizes and breakpoints", learn.microsoft.com, ms.date 2026-07-13, read
             2026-10-25), for the owner to check on their PC. The columns, in the header and in the item template alike: 240 for the name, 160
             for the support, the rest for the notes, which wrap. -->
        <Thickness x:Key="FormatRowPadding">12,8,12,8</Thickness>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The title as a breadcrumb: "A BreadcrumbBar provides the direct path of pages or folders to the current location", and
             "Show the current location as the last item" (Breadcrumb Bar, learn.microsoft.com, ms.date 2025-02-26, read 2026-10-26). The
             same page says not to use one for only two levels; the owner chose it, as Windows Settings titles its nested pages (owner,
             2026-10-26). Its items at the title's size and weight (TitleTextBlockStyle: 28, SemiBold) through the control's own
             lightweight-styling keys, BreadcrumbBarItemThemeFontSize and BreadcrumbBarItemFontWeight (BreadcrumbBar_themeresources.xaml,
             microsoft-ui-xaml main, read 2026-10-26); the chevron's size there is 12, here 16 (not measured against Windows Settings:
             the owner checks it). -->
        <BreadcrumbBar
            x:Name="Breadcrumb"
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="24,24,24,0"
            AutomationProperties.HeadingLevel="Level1"
            AutomationProperties.Name="Settings, Supported formats"
            ItemClicked="OnBreadcrumbClicked">
            <BreadcrumbBar.Resources>
                <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
            </BreadcrumbBar.Resources>
        </BreadcrumbBar>

        <Grid Grid.Row="1" MaxWidth="{StaticResource PageMaxWidth}" Margin="24,24,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- The short description the owner asked for above the tabs, and what the Hardware column rests on. -->
            <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock
                x:Name="HardwareText"
                Grid.Row="1"
                Margin="0,4,0,0"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <InfoBar x:Name="LoadInfo" Grid.Row="2" Margin="0,8,0,0" IsOpen="False" />
            <!-- Five tabs, one list each: "When a user selects an item in the selector bar, you typically change the view by ...
                 changing the data shown in a collection control" (Selector bar, learn.microsoft.com, ms.date 2025-02-26, read
                 2026-10-26). Text only, as the owner's mock. The arrow keys move between items: the control's own keyboard handling. -->
            <SelectorBar
                x:Name="Tabs"
                Grid.Row="3"
                Margin="0,12,0,0"
                AutomationProperties.Name="Kind of format"
                SelectionChanged="OnTabChanged">
                <SelectorBarItem Text="Video" Tag="Video" />
                <SelectorBarItem Text="Audio" Tag="Audio" />
                <SelectorBarItem Text="Containers" Tag="Containers" />
                <SelectorBarItem Text="Subtitles" Tag="Subtitles" />
                <SelectorBarItem Text="HDR" Tag="Hdr" />
            </SelectorBar>
            <!-- Column headers over the list, in the rows' columns (the item template below). Each row is also read whole, as
                 "name, support, notes". -->
            <!-- 4 more at each side: the list's items keep ListViewItem's default margin (4 at the sides, not verified; the owner checks
                 the alignment). -->
            <Grid
                Grid.Row="4"
                Margin="4,12,4,0"
                Padding="{StaticResource FormatRowPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NameHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Codec" />
                <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="On this PC" />
                <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Notes" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" MaxWidth="{StaticResource PageMaxWidth}" Margin="24,0,24,24">
            <ProgressRing x:Name="Loading" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
            <!-- A list the keyboard and Narrator walk row by row; nothing to select or click. Each row is named for Narrator in
                 ContainerContentChanging, as the add-server page names its found servers. -->
            <ListView
                x:Name="RowsList"
                SelectionMode="None"
                IsItemClickEnabled="False"
                ContainerContentChanging="OnRowContainerChanging">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FormatRowView">
                        <Grid Padding="{StaticResource FormatRowPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Support}" TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Notes}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>

</Page>
