<Page
    x:Class="Current.Shell.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:browsing="using:Current.Shell.Browsing">
    <Page.Resources>
        <!-- A row that scrolls sideways, as Home's; a search narrowed to one type wraps its tiles into a grid, as a library's
             (GridView's own panel). Set per row in SearchPage.xaml.cs. -->
        <ItemsPanelTemplate x:Key="RowPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapPanel">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Page.Resources>
    <!-- F5 and Ctrl+R search again, as Home and a library's page refresh (owner, 2026-10-25). -->
    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The title with Filter and View on its right, as a library's page has them (LibraryPage.xaml, where the layout and the
             View menu's glyphs are sourced; ADR 0022, choices 1 and 2). A search's own: the Favourites tab has neither. Filter lists
             the core's choices (owner, 2026-10-26 and 2026-10-27; ADR 0018, "Global search filters"), a Type group and a Source group
             of radio items, built in SearchPage.xaml.cs. No Sort: results stay in the server's relevance order. Glyph: Segoe Fluent
             Icons E71C "Filter" ("Segoe Fluent Icons font", learn.microsoft.com, ms.date 2026-10-13, read 2026-10-27). -->
        <Grid Margin="24,24,24,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                Margin="0"
                Style="{StaticResource WidePageTitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level1" />
            <StackPanel x:Name="Tools" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <DropDownButton x:Name="FilterButton" AutomationProperties.Name="Filter" ToolTipService.ToolTip="Filter">
                    <FontIcon Glyph="&#xE71C;" FontSize="16" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="FilterMenu" Placement="BottomEdgeAlignedRight" Opening="OnFilterMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="ViewButton" AutomationProperties.Name="View" ToolTipService.ToolTip="View">
                    <FontIcon Glyph="&#xF0E2;" FontSize="16" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="PosterItem" Text="Posters" GroupName="shape" Click="OnViewChosen">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C3;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="WideItem" Text="Wide" GroupName="shape" Click="OnViewChosen">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEF6B;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="TitlesItem" Text="Show titles" Click="OnViewChosen">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8BA;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>
        <!-- "display a single-line "No results" message as the result so that users know their search request executed" (Guidelines
             for auto-suggest boxes, learn.microsoft.com, ms.date 2025-02-26, read 2026-10-25). Live, so Narrator hears the outcome. -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Margin="24,12,24,0"
            Style="{StaticResource BodyTextBlockStyle}"
            AutomationProperties.LiveSetting="Polite" />
        <ProgressRing x:Name="LoadingRing" Grid.Row="2" Width="48" Height="48" IsActive="False" AutomationProperties.Name="Searching" />

        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="Sections" Margin="24,0,0,24" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="browsing:SearchSection">
                        <StackPanel>
                            <TextBlock
                                Margin="0,12,24,0"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level2"
                                Text="{x:Bind Header}"
                                Visibility="{x:Bind HeaderVisibility}" />
                            <!-- Its rows are set from code once per section (StableSource), not by x:Bind. -->
                            <ItemsControl IsTabStop="False" Loaded="OnSectionRowsLoaded">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="browsing:TileRow">
                                        <StackPanel>
                                            <TextBlock
                                                Style="{StaticResource SectionHeaderTextBlockStyle}"
                                                AutomationProperties.HeadingLevel="Level3"
                                                Text="{x:Bind Title}"
                                                Visibility="{x:Bind HeaderTextVisibility}" />
                                            <!-- A Favourites row's header links to that kind's whole list, as Home's row headers do
                                                 (HomePage.xaml, where the margin and glyph are sourced). -->
                                            <HyperlinkButton
                                                Margin="-11,7,0,2"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind HeaderLinkTip}"
                                                Click="OnRowHeader"
                                                AutomationProperties.HeadingLevel="Level3"
                                                AutomationProperties.Name="{x:Bind Title}"
                                                Visibility="{x:Bind HeaderLinkVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        Text="{x:Bind Title}" />
                                                    <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                            <!-- Under a full group: only the best matches show (the core's SearchFilter.Note), as a
                                                 library's search notes its window (LibraryPage's count line). -->
                                            <TextBlock
                                                Margin="0,0,24,8"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Note, Mode=OneWay}"
                                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                                            <!-- The bottom padding keeps the scroll bar off the tiles: with the 4 each item has below it, 20, the bar's
                                                 16 (ScrollBarSize, generic.xaml of Microsoft.WindowsAppSDK.WinUI 2.3.9) and a 4 gap as on Home (owner's run,
                                                 2026-10-26). -->
                                            <!-- Its items and template are set from code once per row (StableSource), not by x:Bind. -->
                                            <GridView
                                                Padding="0,0,20,16"
                                                AutomationProperties.Name="{x:Bind Title}"
                                                ScrollViewer.HorizontalScrollMode="Enabled"
                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                Loaded="OnRowLoaded" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
