<Page
    x:Class="Current.Shell.Pages.AddServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Current.Bindings">
    <!-- Esc stops a running probe (docs/notes/windows-shell.md, "Keyboard and Narrator"). -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </Page.KeyboardAccelerators>

    <!-- The form keeps its own width at the left of the page column (App.xaml, PageColumnStyle). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Add a server" />
        <ScrollViewer Grid.Row="1">
            <Border>
                <Grid Style="{StaticResource PageColumnStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="560" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="Enter the address of your Jellyfin server, or pick one found on your network." />

                        <!-- The address. Enter connects; the error shows on the page, not in a dialog (Dialogs page, learn.microsoft.com). -->
                        <TextBox
                            x:Name="AddressBox"
                            Header="Server address"
                            PlaceholderText="192.168.1.10:8096 or media.example.com"
                            InputScope="Url"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            KeyDown="OnAddressKeyDown"
                            TextChanged="OnAddressChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConnectButton" Style="{StaticResource AccentButtonStyle}" Content="Connect" Click="OnConnect" />
                            <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="OnCancel" />
                        </StackPanel>
                        <StackPanel x:Name="ProbingPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <ProgressRing x:Name="ProbingRing" Width="20" Height="20" IsActive="False" />
                            <TextBlock
                                x:Name="ProbingText"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Text="Connecting…" />
                        </StackPanel>
                        <InfoBar x:Name="ProbeError" Severity="Error" IsClosable="False" IsOpen="False" />

                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.HeadingLevel="Level2"
                            Text="Servers on your network" />
                        <!-- Searching does not block the page: a bar, not a ring (progress controls page, learn.microsoft.com). -->
                        <ProgressBar x:Name="SearchingBar" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Searching" />
                        <ListView
                            x:Name="FoundList"
                            AutomationProperties.Name="Servers on your network"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnPickServer"
                            ContainerContentChanging="OnFoundContainerChanging">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="bindings:DiscoveredServer">
                                    <StackPanel Padding="0,8">
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Version}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="SearchStatus"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="Collapsed" />
                        <Button x:Name="SearchAgainButton" Content="Search again" Visibility="Collapsed" Click="OnSearchAgain" />
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
