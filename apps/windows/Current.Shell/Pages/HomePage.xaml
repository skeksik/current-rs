<Page
    x:Class="Current.Shell.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Current.Shell.ViewModels"
    xmlns:browsing="using:Current.Shell.Browsing">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <!-- F5 and Ctrl+R refresh the rows, as on a library's page. -->
    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="TitleText"
            Style="{StaticResource PageTitleTextBlockStyle}"
            AutomationProperties.HeadingLevel="Level1"
            Text="Home" />

        <!-- With a signed-in Jellyfin server: its rows (ADR 0018, section 6). Home's layout is provisional: the owner will have it
             redesigned (2026-10-25). Each row scrolls sideways; the page scrolls down. -->
        <ScrollViewer x:Name="Feed" Grid.Row="1" Visibility="Collapsed">
            <ItemsControl x:Name="Sections" Margin="24,0,0,24" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="browsing:HomeSection">
                        <StackPanel>
                            <TextBlock
                                Margin="0,12,24,0"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level2"
                                Text="{x:Bind Header, Mode=OneWay}"
                                Visibility="{x:Bind HeaderVisibility, Mode=OneWay}" />
                            <InfoBar Margin="0,12,24,0" IsClosable="False" Loaded="OnSectionInfoLoaded" Tag="{x:Bind}">
                                <InfoBar.ActionButton>
                                    <Button Content="Retry" Tag="{x:Bind}" Click="OnRetrySection" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <ItemsControl ItemsSource="{x:Bind Rows}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="browsing:TileRow">
                                        <StackPanel>
                                            <TextBlock
                                                Style="{StaticResource SectionHeaderTextBlockStyle}"
                                                AutomationProperties.HeadingLevel="Level3"
                                                Text="{x:Bind Title}" />
                                            <!-- The right padding keeps the last tile off the window's edge, less the 4 each item
                                                 has on its right by default (LibraryPage.xaml). -->
                                            <GridView
                                                Padding="0,0,20,0"
                                                ItemsSource="{x:Bind Items}"
                                                ItemTemplate="{x:Bind ItemTemplate}"
                                                AutomationProperties.Name="{x:Bind Title}"
                                                ScrollViewer.HorizontalScrollMode="Enabled"
                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                Loaded="OnRowLoaded">
                                                <GridView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsStackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </GridView.ItemsPanel>
                                            </GridView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid x:Name="M1Content" Grid.Row="1">
            <!-- While the core opens; shown only if that takes a moment. -->
            <ProgressRing
                x:Name="Opening"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="48"
                Height="48"
                IsActive="False"
                AutomationProperties.Name="Opening Current" />

            <TextBlock
                x:Name="CoreFailed"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Current couldn't start. Close it and open it again." />

            <!-- The state before any server exists (docs/notes/windows-shell.md, "Screens"). -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480"
                Spacing="8"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Text="No servers yet" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Add a Jellyfin server to browse and play your media." />
                <Button
                    x:Name="AddFirstServer"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Add a server"
                    Click="OnAddServer" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.FaultedVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    HorizontalAlignment="Center"
                    Text="Couldn't refresh the server list." />
                <Button HorizontalAlignment="Center" Content="Reload" Click="OnReload" />
            </StackPanel>

            <!-- Signed-in servers: the server and user for now; browsing comes with M2 (docs/roadmap.md). -->
            <ScrollViewer Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                <Border>
                    <Grid Style="{StaticResource PageColumnStyle}">
                        <StackPanel Spacing="4">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServerRow">
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        AutomationProperties.HeadingLevel="Level2"
                                                        Text="{x:Bind Name, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind Account, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Product, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Connection, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Content="Sign in"
                                                    AutomationProperties.Name="{x:Bind SignInLabel, Mode=OneWay}"
                                                    Visibility="{x:Bind SignInVisibility, Mode=OneWay}"
                                                    Click="OnSignInAgain" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Margin="0,8,0,0" Content="Add another server" Click="OnAddServer" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
