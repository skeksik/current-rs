<Page
    x:Class="Current.Shell.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Current.Shell.ViewModels"
    xmlns:browsing="using:Current.Shell.Browsing"
    NavigationCacheMode="Required">
    <!-- Kept by the frame: going back to Home shows this same page, its rows and tiles where they were, every scroll offset
         included, rather than a page built again (the owner's run, 2026-10-25). "Required: The page is cached and the cached instance
         is reused for every visit regardless of the cache size for the frame" (NavigationCacheMode Enum, learn.microsoft.com,
         updated 2026-07-28, read 2026-10-25). -->
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <!-- F5 and Ctrl+R refresh the rows, as on a library's page. -->
    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The title with Edit Home on its right (ADR 0024, owner, 2026-10-28), as a library's page has its commands: it opens the
             rows' list in a dialog, the same list as Settings' "Home" expander (Browsing/ArrangementEditor). Shown while a server is
             signed in. Glyph: Segoe Fluent Icons E70F "Edit" ("Segoe Fluent Icons font", learn.microsoft.com, ms.date 2026-10-13, read
             2026-10-28). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource PageTitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level1"
                Text="Home" />
            <Button
                x:Name="EditHomeButton"
                Grid.Column="1"
                Margin="0,24,24,0"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="OnEditHome">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE70F;" />
                    <TextBlock Text="Edit Home" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- With a signed-in Jellyfin server: its rows (ADR 0018, section 6). Home's layout is provisional: the owner will have it
             redesigned (2026-10-25). Each row scrolls sideways; the page scrolls down. -->
        <ScrollViewer x:Name="Feed" Grid.Row="1" Visibility="Collapsed">
            <ItemsControl x:Name="Sections" Margin="24,0,0,24" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="browsing:HomeSection">
                        <StackPanel>
                            <TextBlock
                                Margin="0,12,24,0"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level2"
                                Text="{x:Bind Header}"
                                Visibility="{x:Bind HeaderVisibility}" />
                            <InfoBar Margin="0,12,24,0" IsClosable="False" Loaded="OnSectionInfoLoaded" Tag="{x:Bind}">
                                <InfoBar.ActionButton>
                                    <Button Content="Retry" Tag="{x:Bind}" Click="OnRetrySection" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <!-- Its rows are set from code once per section (StableSource), not by x:Bind. -->
                            <ItemsControl IsTabStop="False" Loaded="OnSectionRowsLoaded">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="browsing:TileRow">
                                        <StackPanel>
                                            <TextBlock
                                                Style="{StaticResource SectionHeaderTextBlockStyle}"
                                                AutomationProperties.HeadingLevel="Level3"
                                                Text="{x:Bind Title}"
                                                Visibility="{x:Bind HeaderTextVisibility}" />
                                            <!-- A row with a page of its own (a library's latest): its header is a link to it, with a
                                                 chevron, still a heading for Narrator (owner, 2026-10-26; no Microsoft guideline for a
                                                 clickable section header found, not verified). The margin takes back the button's
                                                 padding (ButtonPadding 11,5,11,6, generic.xaml of Microsoft.WindowsAppSDK.WinUI 2.3.9),
                                                 so the text sits where the plain header's does (SectionHeaderTextBlockStyle's 0,12,0,8).
                                                 Glyph: Segoe Fluent Icons E76C "ChevronRight" ("Segoe Fluent Icons font",
                                                 learn.microsoft.com, ms.date 2026-10-13, not re-read for this). The tooltip names where
                                                 it goes: "Add tooltips to hyperlinks that indicate to where the user will be directed"
                                                 (Hyperlinks page, learn.microsoft.com, ms.date 2025-02-26, read 2026-10-26). -->
                                            <HyperlinkButton
                                                Margin="-11,7,0,2"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind HeaderLinkTip}"
                                                Click="OnRowHeader"
                                                AutomationProperties.HeadingLevel="Level3"
                                                AutomationProperties.Name="{x:Bind Title}"
                                                Visibility="{x:Bind HeaderLinkVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        Text="{x:Bind Title}" />
                                                    <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                            <!-- The right padding keeps the last tile off the window's edge, less the 4 each item
                                                 has on its right by default (LibraryPage.xaml). -->
                                            <!-- The bottom padding keeps the scroll bar off the tiles: with the 4 each item has below it, 20, the bar's
                                                 16 (ScrollBarSize, generic.xaml of Microsoft.WindowsAppSDK.WinUI 2.3.9) and a 4 gap (owner's run,
                                                 2026-10-26). -->
                                            <!-- Its items and template are set from code once per row (StableSource), not by x:Bind. -->
                                            <GridView
                                                Padding="0,0,20,16"
                                                AutomationProperties.Name="{x:Bind Title}"
                                                ScrollViewer.HorizontalScrollMode="Enabled"
                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                Loaded="OnRowLoaded">
                                                <GridView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsStackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </GridView.ItemsPanel>
                                            </GridView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid x:Name="M1Content" Grid.Row="1">
            <!-- While the core opens; shown only if that takes a moment. -->
            <ProgressRing
                x:Name="Opening"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="48"
                Height="48"
                IsActive="False"
                AutomationProperties.Name="Opening Current" />

            <TextBlock
                x:Name="CoreFailed"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Current couldn't start. Close it and open it again." />

            <!-- The state before any server exists (docs/notes/windows-shell.md, "Screens"). -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480"
                Spacing="8"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Text="No servers yet" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Add a Jellyfin server to browse and play your media." />
                <Button
                    x:Name="AddFirstServer"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Add a server"
                    Click="OnAddServer" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.FaultedVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    HorizontalAlignment="Center"
                    Text="Couldn't refresh the server list." />
                <Button HorizontalAlignment="Center" Content="Reload" Click="OnReload" />
            </StackPanel>

            <!-- Signed-in servers: the server and user for now; browsing comes with M2 (docs/roadmap.md). -->
            <ScrollViewer Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                <Border>
                    <Grid Style="{StaticResource PageColumnStyle}">
                        <StackPanel Spacing="4">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServerRow">
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        AutomationProperties.HeadingLevel="Level2"
                                                        Text="{x:Bind Name, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind Account, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Product, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Connection, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Content="Sign in"
                                                    AutomationProperties.Name="{x:Bind SignInLabel, Mode=OneWay}"
                                                    Visibility="{x:Bind SignInVisibility, Mode=OneWay}"
                                                    Click="OnSignInAgain" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Margin="0,8,0,0" Content="Add another server" Click="OnAddServer" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
