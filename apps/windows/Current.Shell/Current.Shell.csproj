<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Windows app (docs/notes/windows-shell.md): WinUI 3, unpackaged and self-contained, over the C# bindings (ADR 0004). It renders
    the core's state and holds only platform integration (ADR 0001).
    Pass -p:Platform=x64 with -r win-x64 (WinUI has no AnyCPU) and -p:CoreLibDir=<directory of current_ffi.dll>; build.ps1 does.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Current.Shell</RootNamespace>
    <!-- The executable is Current.exe. -->
    <AssemblyName>Current</AssemblyName>
    <Product>Current</Product>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The MSIX tooling also builds the app's PRI file (its compiled XAML and resources); without it the publish folder has none and
         loading MainWindow.xaml fails with "Cannot locate resource". The typical WinUI project in "Project properties and
         auto-initializers" (learn.microsoft.com, ms.date 2026-10-02, read 2026-10-22) sets it. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1603</WarningsNotAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.cs has its own Main: single instance and the AppUserModelID come before any window (docs/notes/windows-shell.md). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows App SDK 2.5.1 as component packages, not the Microsoft.WindowsAppSDK metapackage, so the app ships no AI, ML, Widgets or
      Search runtime it does not use (docs/notes/windows-shell.md). These are the versions the 2.5.1 metapackage pins. WinUI brings
      Foundation (AppLifecycle) and Base. It asks for InteractiveExperiences 2.1.8, which nuget.org does not have, so 2.1.9 is named
      here, and NuGet's NU1603 notice about it stays a warning.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <!--
      The Windows Community Toolkit's SettingsCard and SettingsExpander, which Microsoft's settings guidelines recommend (owner,
      2026-10-23). 8.3.260402-preview2 is a preview: the stable 8.2.251219 depends on the whole Microsoft.WindowsAppSDK package, this one
      only on Microsoft.WindowsAppSDK.WinUI (>= 1.8.260204000), which the 2.3.9 above satisfies. It brings Triggers, Helpers and
      Extensions at the same version and CommunityToolkit.Common 8.2.1, all MIT (docs/notes/windows-shell.md). Move to 8.3 stable when
      it ships (docs/roadmap.md). Each is pinned exactly with NuGet's bracket form, the transitive ones too, so a restore can never pick
      another version. (The WinUI references above remain minimums, with NU1603 as a warning: a follow-up, docs/roadmap.md.)
    -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="[8.3.260402-preview2]" />
    <PackageReference Include="CommunityToolkit.WinUI.Triggers" Version="[8.3.260402-preview2]" />
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="[8.3.260402-preview2]" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="[8.3.260402-preview2]" />
    <PackageReference Include="CommunityToolkit.Common" Version="[8.2.1]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings current_ffi.dll along when CoreLibDir is set. -->
    <ProjectReference Include="../../../bindings/csharp/Current.Bindings/Current.Bindings.csproj" />
  </ItemGroup>
</Project>
