<Application
    x:Class="Current.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:browsing="using:Current.Shell.Browsing">
    <!-- No RequestedTheme: the app follows the Windows light/dark setting. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The shade under a tile's progress (ItemTile.xaml): clear at its top, 60 % black just above the glyphs' top (0.45 of
                 its 44; the time's glyphs start at about 0.48) and 80 % at the bottom: SystemAltMediumColor and
                 SystemAltMediumHighColor in the dark theme the tile shows it in (generic.xaml of Microsoft.WindowsAppSDK.WinUI 2.3.9).
                 Text needs "a minimum luminance contrast ratio of 4.5:1" ("Accessible text requirements", learn.microsoft.com,
                 ms.date 2026-08-21, read 2026-10-26). Measured where it is lowest, at the lightest background pixel beside the time's
                 glyphs at their top row (WCAG relative luminance of the pixel, white text; a 150 % capture of the owner's run on a
                 light poster, 2026-10-27): 6.6:1; over a pure white poster the shade's 61 % there gives about 6.0:1 (computed). The
                 first shade (30 % black throughout) left about 2.1:1; 40 % at 0.36 measured 4.7:1 at the shade's middle but only
                 about 3.6:1 at the glyphs' top. The clear end is transparent black (SystemControlTransparentColor, #00000000):
                 "Transparent" is transparent white, and the fade from it to black passed through a see-through grey that lightened
                 the picture in a line above the bar. High contrast uses the system's window colour (SystemColorWindowColorBrush),
                 whole, under the window text colour: its alt and smoke colours are not meant for this there. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="TileScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{ThemeResource SystemControlTransparentColor}" />
                        <GradientStop Offset="0.45" Color="{ThemeResource SystemAltMediumColor}" />
                        <GradientStop Offset="1" Color="{ThemeResource SystemAltMediumHighColor}" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="TileScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{ThemeResource SystemControlTransparentColor}" />
                        <GradientStop Offset="0.45" Color="{ThemeResource SystemAltMediumColor}" />
                        <GradientStop Offset="1" Color="{ThemeResource SystemAltMediumHighColor}" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="TileScrimBrush" ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Every page: its title over one column, centred, up to PageMaxWidth, as the WinUI Gallery's settings page lays out its
                 title and column (docs/notes/windows-shell.md, "Page layout"). Each page puts the column in a plain Border inside its
                 ScrollViewer, as the Gallery does; as the ScrollViewer's direct content it was placed off-centre (owner's run,
                 2026-10-24). -->
            <x:Double x:Key="PageMaxWidth">1064</x:Double>
            <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="MaxWidth" Value="{StaticResource PageMaxWidth}" />
                <Setter Property="Margin" Value="24,24,24,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="PageColumnStyle" TargetType="Grid">
                <Setter Property="MaxWidth" Value="{StaticResource PageMaxWidth}" />
                <Setter Property="Margin" Value="24" />
            </Style>

            <!-- Browse pages (Home, a library, search) fill the window, as a grid of media should; their title sits at the page
                 margin: "We recommend 12px margins for your content area when NavigationView is in Minimal mode and 24px margins
                 otherwise" (NavigationView page, learn.microsoft.com, ms.date 2026-10-02, read 2026-10-25; Minimal is never reached
                 here, MainWindow.xaml). -->
            <Style x:Key="WidePageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="24,24,24,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <!-- Tile widths: Microsoft gives none for media posters (no poster size or aspect found in its design pages, read
                 2026-10-25; the "Image and text" grid template's sample image is 180 × 180), so these are provisional until measured
                 against Microsoft's own media apps with the owner (docs/notes/windows-shell.md, "Browse: Windows run"). Multiples of 4:
                 "The sizes, margins, and positions of UI elements should always be in multiples of 4 epx" ("Screen sizes and
                 breakpoints", learn.microsoft.com, ms.date 2026-07-13, read 2026-10-25). Posters are 2:3, wide tiles 16:9
                 (ItemTile). -->
            <x:Double x:Key="PosterTileWidth">160</x:Double>
            <x:Double x:Key="WideTileWidth">256</x:Double>
            <!-- A mark over a tile's picture (played, favourite, unplayed count): accent fill and its text colour, which have
                 high-contrast values of their own. -->
            <Style x:Key="TileBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="4,0" />
            </Style>
            <!-- Between a section's header and its content, and between sections: "8epx between control and header", "12epx
                 between content areas" ("Content layout and spacing", learn.microsoft.com, ms.date 2026-10-13, read 2026-10-25). -->
            <Style x:Key="SectionHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,12,0,8" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <DataTemplate x:Key="PosterTileTemplate">
                <browsing:ItemTile Shape="Poster" TileWidth="{StaticResource PosterTileWidth}" />
            </DataTemplate>
            <DataTemplate x:Key="WideTileTemplate">
                <browsing:ItemTile Shape="Wide" TileWidth="{StaticResource WideTileWidth}" />
            </DataTemplate>
            <!-- The picture only: a library's View menu with Show titles off. -->
            <DataTemplate x:Key="PosterPictureTemplate">
                <browsing:ItemTile Shape="Poster" ShowsText="False" TileWidth="{StaticResource PosterTileWidth}" />
            </DataTemplate>
            <DataTemplate x:Key="WidePictureTemplate">
                <browsing:ItemTile Shape="Wide" ShowsText="False" TileWidth="{StaticResource WideTileWidth}" />
            </DataTemplate>
            <DataTemplate x:Key="EpisodeTileTemplate">
                <browsing:ItemTile Shape="Wide" ShowsSeries="False" TileWidth="{StaticResource WideTileWidth}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
