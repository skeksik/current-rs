<UserControl
    x:Class="Current.Shell.Browsing.ItemTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- One item as a tile: its picture (the BlurHash first, then the image), the marks over it, and one or two lines of text under
         it, as the "Image and text" item template does ("Item templates for grid view", learn.microsoft.com, ms.date 2026-10-13, read
         2026-10-25: the subtitle in CaptionTextBlockStyle). Colours are theme resources only, which have their own values in high
         contrast; none is hard-coded ("Contrast themes", learn.microsoft.com, ms.date 2026-08-29, read 2026-10-25). -->
    <StackPanel x:Name="Root" Spacing="4">
        <Grid
            x:Name="Picture"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Image x:Name="Placeholder" Stretch="UniformToFill" />
            <Image x:Name="Artwork" Stretch="UniformToFill" />
            <!-- A slot whose page failed: the grid's message above offers Retry. -->
            <FontIcon
                x:Name="FailedGlyph"
                Visibility="Collapsed"
                Glyph="&#xE7BA;"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel
                Margin="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="4">
                <Border x:Name="FavouriteBadge" Visibility="Collapsed" Style="{StaticResource TileBadgeStyle}">
                    <FontIcon Glyph="&#xEB52;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <Border x:Name="PlayedBadge" Visibility="Collapsed" Style="{StaticResource TileBadgeStyle}">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <Border x:Name="UnplayedBadge" Visibility="Collapsed" Style="{StaticResource TileBadgeStyle}">
                    <TextBlock
                        x:Name="UnplayedCount"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
            <ProgressBar x:Name="Progress" Visibility="Collapsed" Margin="8" VerticalAlignment="Bottom" Maximum="1" />
        </Grid>
        <TextBlock
            x:Name="TitleText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            x:Name="SubtitleText"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
    </StackPanel>
</UserControl>
