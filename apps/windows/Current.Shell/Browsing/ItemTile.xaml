<UserControl
    x:Class="Current.Shell.Browsing.ItemTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Top"
    IsTabStop="False">
    <!-- One item as a tile: its picture (the BlurHash first, then the image), the marks over it, and one or two lines of text under
         it, as the "Image and text" item template does ("Item templates for grid view", learn.microsoft.com, ms.date 2026-10-13, read
         2026-10-25: the subtitle in CaptionTextBlockStyle). Colours are theme resources only, which have their own values in high
         contrast; none is hard-coded ("Contrast themes", learn.microsoft.com, ms.date 2026-08-29, read 2026-10-25). -->
    <!-- The tile (VerticalAlignment above) sits at the top of its item: grid and list items centre their content
         (VerticalContentAlignment, generic.xaml of Microsoft.WindowsAppSDK.WinUI 2.3.9), so a tile without a subtitle sat half a line
         lower than its neighbours (owner's run, 2026-10-26). -->
    <StackPanel x:Name="Root" Spacing="4">
        <Grid
            x:Name="Picture"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <!-- The pictures as image brushes of rounded borders: a panel's CornerRadius rounds its own background and border but
                 does not clip an Image in it, whose corners stayed square (owner's run, 2026-10-26). 4 px: "In-page elements such as
                 buttons and list backplates are rounded using a 4px corner radius" ("Geometry in Windows 11", learn.microsoft.com,
                 ms.date 2021-06-24, read 2026-10-26), ControlCornerRadius. -->
            <Border CornerRadius="{StaticResource ControlCornerRadius}">
                <Border.Background>
                    <ImageBrush x:Name="Placeholder" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border CornerRadius="{StaticResource ControlCornerRadius}">
                <Border.Background>
                    <ImageBrush x:Name="Artwork" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <!-- A slot whose page failed: the grid's message above offers Retry. -->
            <FontIcon
                x:Name="FailedGlyph"
                Visibility="Collapsed"
                Glyph="&#xE7BA;"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel
                Margin="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="4">
                <Border x:Name="FavouriteBadge" Visibility="Collapsed" Style="{StaticResource TileBadgeStyle}">
                    <FontIcon Glyph="&#xEB52;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <Border x:Name="PlayedBadge" Visibility="Collapsed" Style="{StaticResource TileBadgeStyle}">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <!-- The count in the middle of its badge: a TextBlock sits at the top left of a Border by default, and its line's
                     space above the digits left them low and off-centre (owner's run, 2026-10-26). Tight line bounds keep only the
                     digits' height (cap height to baseline), so centring them centres what shows. -->
                <Border x:Name="UnplayedBadge" Visibility="Collapsed" Style="{StaticResource TileBadgeStyle}">
                    <TextBlock
                        x:Name="UnplayedCount"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextLineBounds="Tight"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
            <!-- An item in progress: a play mark, how far it was watched, and the time left as the core counts it (owner,
                 2026-10-26), on a shade along the picture's bottom (TileScrimBrush, App.xaml). In the dark theme whatever the app's,
                 so the text is light on the shade; high contrast keeps its own colours. Decorative for Narrator: the tile's name says
                 it (BrowseText.TileName). Glyph: Segoe Fluent Icons E768 "Play" ("Segoe Fluent Icons font", learn.microsoft.com,
                 ms.date 2026-10-13, read 2026-10-26). -->
            <Grid
                x:Name="ProgressPart"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                Padding="8,16,8,8"
                ColumnSpacing="8"
                RequestedTheme="Dark"
                Background="{ThemeResource TileScrimBrush}"
                AutomationProperties.AccessibilityView="Raw">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <ProgressBar x:Name="Progress" Grid.Column="1" VerticalAlignment="Center" Maximum="1" />
                <TextBlock
                    x:Name="TimeLeftText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Grid>
        </Grid>
        <!-- The text 8 in from the item's highlight on the left, right and below; the picture stays flush with it (owner,
             2026-10-26). -->
        <StackPanel x:Name="TextPart" Margin="8,0,8,8" Spacing="4">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource BodyTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <!-- The subtitle's line is kept when an item has none (no year), so every tile is as tall as its neighbours (owner,
                 2026-10-26): an unseen line in the same style holds it, and follows a text-size change as the subtitle does. -->
            <Grid>
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="0"
                    Opacity="0"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Name="SubtitleText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
