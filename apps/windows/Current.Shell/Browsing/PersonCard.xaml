<UserControl
    x:Class="Current.Shell.Browsing.PersonCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- PersonPicture shows the person's initials until the photo loads, or for good when there is none. -->
    <StackPanel Width="120" Spacing="4">
        <PersonPicture x:Name="Picture" Width="100" Height="100" />
        <TextBlock
            x:Name="NameText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            x:Name="RoleText"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
    </StackPanel>
</UserControl>
