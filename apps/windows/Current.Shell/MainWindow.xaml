<Window
    x:Class="Current.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Current">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <!-- Alt+Left, the GoBack key and the mouse Back button go back, Alt+Right and the mouse Forward button go forward, from anywhere
         in the window (docs/notes/windows-shell.md). -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- With a custom title bar, the navigation view's back and pane buttons move into it (the TitleBar control's page). -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Current"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="False"
            BackRequested="OnTitleBarBackRequested"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <!-- A disabled back button keeps its transparent background and only dims its glyph, as the navigation view's own back
                 button does: its Disabled state sets only the glyph's foreground (NavigationBackButton.xaml), while the title bar's
                 fills the button with ControlFillColorDisabledBrush (TitleBarBackButtonBackgroundDisabled,
                 TitleBar_themeresources.xaml; both microsoft-ui-xaml, tag winui3/release/2.5.1, read 2026-10-23). High contrast
                 keeps the control's own value, which is the same as its enabled one. -->
            <TitleBar.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SystemControlBackgroundBaseLowBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <!-- The tall title bar, 48 px like Windows Settings' (owner's run, 2026-10-24), with standard caption buttons. The control's
                         layout root takes TitleBarCompactHeight (32) and switches to TitleBarExpandedHeight (48) only when Content,
                         LeftHeader or RightHeader is set (TitleBar.xaml, UpdateHeight in TitleBar.cpp, microsoft-ui-xaml, tag
                         winui3/release/2.5.1, read 2026-10-24). This one has none, so the compact height itself is raised. -->
                    <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                </ResourceDictionary>
            </TitleBar.Resources>
        </TitleBar>

        <!-- The navigation view's "Compact" adaptive pattern, so the pane is never hidden (owner, 2026-10-24): "an expanded left pane
             on large window widths, and a LeftCompact, icon-only, nav pane on both medium and small window widths … set
             CompactModeThresholdWidth to 0" (NavigationView page, learn.microsoft.com, ms.date 2026-10-02, read 2026-10-24). From
             1008 px (the default ExpandedModeThresholdWidth) the title bar's pane button switches between the full pane and the icon
             rail inline; below that the rail shows and the opened pane covers the page.
             OpenPaneLength: Windows Settings' full pane (owner, 2026-10-24). 280 is a placeholder until the owner's measurement; the
             control's default is 320, and no Microsoft guideline gives a value. -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            OpenPaneLength="280"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="OnItemInvoked"
            DisplayModeChanged="OnDisplayModeChanged"
            PaneOpened="OnPaneOpenedOrClosed"
            PaneClosed="OnPaneOpenedOrClosed">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="home" Icon="Home" />
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Notices about the app's state that every page shows (App.ShowNotice): settings reset, a sign-in not remembered. They
                     are centred with the page's column (App.xaml). -->
                <StackPanel x:Name="Notices" MaxWidth="{StaticResource PageMaxWidth}" Margin="24,0" Spacing="8" />
                <Frame x:Name="ContentFrame" Grid.Row="1" IsTabStop="True" Navigated="OnNavigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
