<Window
    x:Class="Current.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:player="using:Current.Shell.Player"
    Title="Current">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <!-- Alt+Left, the GoBack key and the mouse Back button go back, Alt+Right and the mouse Forward button go forward, from anywhere
         in the window (docs/notes/windows-shell.md). -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Ctrl+E goes to the search box: on Windows it "launches search" in Edge and many Store apps (Keyboard interactions,
             learn.microsoft.com, ms.date 2026-09-27, read 2026-10-25). -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnSearchAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- With a custom title bar, the navigation view's back and pane buttons move into it (the TitleBar control's page).
             Margin: "The back button should be 16px from the left-most border" ("Windows app title bar", learn.microsoft.com, ms.date
             2024-07-31, read 2026-10-24). The back button is 40 px wide with a 2 px margin (TitleBarBackButtonStyle), and the control
             sets its left padding column to the window's left inset (0 left to right; not verified on screen) in place of
             TitleBarLeftPaddingWidth (UpdatePadding in TitleBar.cpp; both microsoft-ui-xaml, tag winui3/release/2.5.1, read
             2026-10-24), so its glyph sat 14 px from the border and its backplate 2 px. 2 px more puts the glyph at 16. -->
        <TitleBar
            x:Name="AppTitleBar"
            Canvas.ZIndex="1"
            Margin="2,0,0,0"
            Title="Current"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="False"
            BackRequested="OnTitleBarBackRequested"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <!-- A disabled back button keeps its transparent background and only dims its glyph, as the navigation view's own back
                 button does: its Disabled state sets only the glyph's foreground (NavigationBackButton.xaml), while the title bar's
                 fills the button with ControlFillColorDisabledBrush (TitleBarBackButtonBackgroundDisabled,
                 TitleBar_themeresources.xaml; both microsoft-ui-xaml, tag winui3/release/2.5.1, read 2026-10-23). High contrast
                 keeps the control's own value, which is the same as its enabled one. -->
            <TitleBar.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SystemControlBackgroundBaseLowBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <!-- The tall title bar, 48 px like Windows Settings' (owner's run, 2026-10-24). The
                         guideline's standard is 32 px, and 48 only with a search box or a person picture ("Windows app title bar",
                         learn.microsoft.com, ms.date 2024-07-31, read 2026-10-24); 48 here is the owner's choice (2026-10-24); the caption buttons are as tall (MainWindow.xaml.cs). The control's
                         layout root takes TitleBarCompactHeight (32) and switches to TitleBarExpandedHeight (48) only when Content,
                         LeftHeader or RightHeader is set (TitleBar.xaml, UpdateHeight in TitleBar.cpp, microsoft-ui-xaml, tag
                         winui3/release/2.5.1, read 2026-10-24). This one has none, so the compact height itself is raised. -->
                    <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                    <!-- The back and pane buttons 40 × 36 with 6 px above and below, as Windows Settings' back button in its 48 px title
                         bar (measured on the owner's PC, 2026-10-24; owner's finding: a gap to the window's border). The control's
                         styles stretch them to the bar's height less a 2 px margin (TitleBarBackButtonStyle and
                         TitleBarPaneToggleButtonStyle, TitleBar_themeresources.xaml, microsoft-ui-xaml, tag winui3/release/2.5.1, read
                         2026-10-24), 40 × 44 here; only the top and bottom margin change. -->
                    <Style x:Key="TitleBarBackButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarBackButtonStyle}">
                        <Setter Property="Margin" Value="2,6" />
                    </Style>
                    <Style x:Key="TitleBarPaneToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarPaneToggleButtonStyle}">
                        <Setter Property="Margin" Value="2,6" />
                    </Style>
                    <!-- Refresh beside them, looking and sized as they do: the back button's colours, width and states
                         (TitleBarBackButtonStyle, TitleBar_themeresources.xaml, microsoft-ui-xaml, tag winui3/release/2.5.1, as in
                         generic.xaml of Microsoft.WindowsAppSDK.WinUI 2.3.9), with a glyph in place of its animated arrow. -->
                    <Style x:Key="TitleBarCommandButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="{ThemeResource TitleBarBackButtonBackground}" />
                        <Setter Property="Foreground" Value="{ThemeResource TitleBarBackButtonForeground}" />
                        <Setter Property="Width" Value="{ThemeResource TitleBarBackButtonWidth}" />
                        <!-- 36, as tall as the back and pane buttons (the bar's 48 less 6 above and below): the title bar centres its
                             left header (TitleBarLeftHeaderVerticalAlignment), so Stretch left it as tall as its glyph and its hover
                             backplate smaller than theirs (owner's run, 2026-10-26). -->
                        <Setter Property="Height" Value="36" />
                        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                        <Setter Property="Margin" Value="2,0" />
                        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="RootGrid.Background" Value="{ThemeResource TitleBarBackButtonBackgroundPointerOver}" />
                                                        <Setter Target="Content.Foreground" Value="{ThemeResource TitleBarBackButtonForegroundPointerOver}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="RootGrid.Background" Value="{ThemeResource TitleBarBackButtonBackgroundPressed}" />
                                                        <Setter Target="Content.Foreground" Value="{ThemeResource TitleBarBackButtonForegroundPressed}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <VisualState.Setters>
                                                        <Setter Target="RootGrid.Background" Value="{ThemeResource TitleBarBackButtonBackgroundDisabled}" />
                                                        <Setter Target="Content.Foreground" Value="{ThemeResource TitleBarBackButtonForegroundDisabled}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter
                                            x:Name="Content"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </TitleBar.Resources>
            <!-- Refresh for the page shown, after the back and pane buttons, where File Explorer and Edge have it: refresh must not
                 need the keyboard, "we recommend that you also have a refresh button available for users who don't have a touch
                 interface" (Pull-to-refresh page, learn.microsoft.com, ms.date 2025-02-26, read 2026-10-26; title bar placement:
                 owner, 2026-10-26). Enabled on pages that refresh (IRefreshable). F5 and Ctrl+R are the pages' own keys ("Refresh |
                 F5 or Ctrl + R", Keyboard accelerators page, learn.microsoft.com, ms.date 2026-08-28, read 2026-10-26), named in the
                 tooltip as the Tooltips page asks. Glyph: Segoe Fluent Icons E72C "Refresh" ("Segoe Fluent Icons font",
                 learn.microsoft.com, ms.date 2026-10-13, read 2026-10-26), at 14: at the buttons' 16 it drew larger than their
                 animated arrow and lines (owner's run and a capture of the window, 2026-10-26). -->
            <TitleBar.LeftHeader>
                <Button
                    x:Name="RefreshButton"
                    Style="{StaticResource TitleBarCommandButtonStyle}"
                    IsEnabled="False"
                    AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Refresh (F5)"
                    Click="OnRefreshClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </TitleBar.LeftHeader>
        </TitleBar>

        <!-- The navigation view's "Compact" adaptive pattern, so the pane is never hidden (owner, 2026-10-24): "an expanded left pane
             on large window widths, and a LeftCompact, icon-only, nav pane on both medium and small window widths … set
             CompactModeThresholdWidth to 0" (NavigationView page, learn.microsoft.com, ms.date 2026-10-02, read 2026-10-24). From
             1008 px (the default ExpandedModeThresholdWidth) the title bar's pane button switches between the full pane and the icon
             rail inline; below that the rail shows and the opened pane covers the page.
             OpenPaneLength: Windows Settings' full pane, 300 px (measured by the owner, 2026-10-24; Windows 11 build 26300, 150%). No
             Microsoft guideline gives a value, and the control's default is 320.
             The navigation view fills the window, under the title bar, as Windows Settings' does (owner, 2026-10-24): a SplitView
             whose pane can be light-dismissed covers everything outside its own bounds with a dismiss layer while the pane is open,
             unless it "takes up the entire window" (SetupOuterDismissLayer, SplitView_Partial.cpp, microsoft-ui-xaml, tag
             winui3/release/2.5.1, read 2026-10-24). Above the navigation view, the title bar's buttons sat under that layer: no hover,
             and a click only closed the pane. The pane's items and the content layer start below the title bar through the
             template's own margins (NavigationViewPaneContentGridMargin, -1,3 by default, and NavigationViewContentMargin, 0;
             NavigationView_themeresources.xaml, same tag); the control's top padding for a title bar is set only on UWP
             (UpdateTitleBarPadding in NavigationView.cpp, "null in win32"). -->
        <NavigationView
            x:Name="NavView"
            Grid.RowSpan="2"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            OpenPaneLength="300"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="OnItemInvoked"
            DisplayModeChanged="OnDisplayModeChanged"
            PaneOpening="OnPaneOpenedOrClosed"
            PaneOpened="OnPaneOpenedOrClosed"
            PaneClosed="OnPaneOpenedOrClosed">
            <NavigationView.Resources>
                <!-- 48: the title bar's height (TitleBarCompactHeight above). -->
                <Thickness x:Key="NavigationViewPaneContentGridMargin">-1,51,-1,3</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>
            </NavigationView.Resources>
            <!-- App-level search: "An optional AutoSuggestBox control to allow for app-level search. Assign the control to the
                 NavigationView.AutoSuggestBox property." (NavigationView page, learn.microsoft.com, ms.date 2026-10-02, read
                 2026-10-25). Shown only while a Jellyfin server is signed in. -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Visibility="Collapsed"
                    PlaceholderText="Search"
                    AutomationProperties.Name="Search"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchSubmitted" />
            </NavigationView.AutoSuggestBox>
            <!-- Home, then one item per library of each signed-in server, in the user's order (ADR 0018, section 6), added in code
                 ("You can also add items in code", same page); a header names each server when there is more than one. -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="home" Icon="Home" />
                <!-- Between Home and the libraries (owner, 2026-10-26); shown only while there are libraries (ShowLibraries). -->
                <NavigationViewItemSeparator x:Name="LibrariesSeparator" Visibility="Collapsed" />
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Notices about the app's state that every page shows (App.ShowNotice): settings reset, a sign-in not remembered. They
                     are centred with the page's column (App.xaml). -->
                <StackPanel x:Name="Notices" MaxWidth="{StaticResource PageMaxWidth}" Margin="24,0" Spacing="8" />
                <Frame x:Name="ContentFrame" Grid.Row="1" IsTabStop="True" Navigated="OnNavigated" />
            </Grid>
        </NavigationView>

        <!-- The player, over the pages in the same window, as Media Player plays a video in its own window (owner's PC, 2026-10-25); in
             full screen it spans the title bar's row too (MainWindow.xaml.cs). -->
        <player:PlayerView x:Name="Player" Grid.Row="1" />
    </Grid>
</Window>
