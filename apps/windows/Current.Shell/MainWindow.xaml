<Window
    x:Class="Current.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Current.Shell"
    Title="Current">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <!-- Alt+Left, the GoBack key and the mouse Back button go back, Alt+Right and the mouse Forward button go forward, from anywhere
         in the window (docs/notes/windows-shell.md). -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The content layer's brushes, which follow the theme: the navigation view's ContentGrid is bound to them on content
             pages (MainWindow.ApplyContentLayer). The same values as the template's ContentGrid (NavigationView.xaml, tag
             winui3/release/2.5.1, read 2026-10-24). -->
        <Border
            x:Name="ContentLayerBrushes"
            Visibility="Collapsed"
            Background="{ThemeResource NavigationViewContentBackground}"
            BorderBrush="{ThemeResource NavigationViewContentGridBorderBrush}" />

        <!-- With a custom title bar, the navigation view's back and pane buttons move into it (the TitleBar control's page). -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Current"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="False"
            BackRequested="OnTitleBarBackRequested"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <!-- A disabled back button keeps its transparent background and only dims its glyph, as the navigation view's own back
                 button does: its Disabled state sets only the glyph's foreground (NavigationBackButton.xaml), while the title bar's
                 fills the button with ControlFillColorDisabledBrush (TitleBarBackButtonBackgroundDisabled,
                 TitleBar_themeresources.xaml; both microsoft-ui-xaml, tag winui3/release/2.5.1, read 2026-10-23). High contrast
                 keeps the control's own value, which is the same as its enabled one. -->
            <TitleBar.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SystemControlBackgroundBaseLowBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <!-- The tall title bar, 48 px like Windows Settings' (owner's run, 2026-10-24), with standard caption buttons. The control's
                         layout root takes TitleBarCompactHeight (32) and switches to TitleBarExpandedHeight (48) only when Content,
                         LeftHeader or RightHeader is set (TitleBar.xaml, UpdateHeight in TitleBar.cpp, microsoft-ui-xaml, tag
                         winui3/release/2.5.1, read 2026-10-24). This one has none, so the compact height itself is raised. -->
                    <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                </ResourceDictionary>
            </TitleBar.Resources>
        </TitleBar>

        <!-- The navigation view's own adaptive behaviour, as in Task Manager (owner, 2026-10-24): the full pane from 1008 px, the
             icon rail from 641 px, hidden below that (the default thresholds, NavigationView page, learn.microsoft.com, ms.date
             2026-10-02, read 2026-10-24). The title bar's pane button opens and closes it: inline on a wide window, over the
             content on a narrower one. -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="OnItemInvoked"
            PaneOpened="OnPaneOpenedOrClosed"
            PaneClosed="OnPaneOpenedOrClosed">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <!-- The pane opened over the page has the title bar's colour, as Windows Settings' does (owner's run,
                         2026-10-24): the overlay pane's NavigationViewDefaultPaneBackground is AcrylicInAppFillColorDefaultBrush, and
                         SolidBackgroundFillColorBaseBrush (#F3F3F3 light, #202020 dark) is the solid colour of the Mica the title bar
                         shows (NavigationView_themeresources.xaml, Common_themeresources_any.xaml, microsoft-ui-xaml, tag
                         winui3/release/2.5.1, read 2026-10-24). The full pane inline is already transparent over Mica
                         (NavigationViewExpandedPaneBackground). High contrast keeps the control's own value. -->
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SystemControlBackgroundBaseLowBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <!-- The overlay pane's border: the navigation view gives its SplitView a 1 px border on every side
                         (NavigationViewBorderThickness), which the SplitView draws around its pane (PaneRoot, SplitView_themeresources.xaml,
                         same tag), so the pane's top edge showed as a line under the title bar. Only the edge towards the page stays,
                         the SplitView's own default (SplitViewLeftBorderThemeThickness 0,0,1,0). -->
                    <Thickness x:Key="NavigationViewBorderThickness">0,0,1,0</Thickness>
                    <!-- The header's own margins are 56,44,0,0 and, in Minimal, -24,44,0,0, which assumes the navigation view's own
                         pane and back buttons to its left (NavigationView_themeresources.xaml, same tag). Both are 0 here: the header
                         is placed by PageLayout.cs through the HeaderTemplate, the same in every display mode. -->
                    <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
                    <Thickness x:Key="NavigationViewMinimalHeaderMargin">0</Thickness>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <!-- Font size and weight come from the template's header style (28 px SemiBold). -->
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" shell:PageLayout.IsHeader="True" />
                </DataTemplate>
            </NavigationView.HeaderTemplate>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="home" Icon="Home" />
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Notices about the app's state that every page shows (App.ShowNotice): settings reset, a sign-in not remembered. -->
                <StackPanel x:Name="Notices" Spacing="8" />
                <Frame x:Name="ContentFrame" Grid.Row="1" IsTabStop="True" Navigated="OnNavigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
