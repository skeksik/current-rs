<Project Sdk="Microsoft.NET.Sdk">
  <!-- A plain console test runner (no test framework package): exits non-zero on any failure. test.ps1 runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- current_ffi.dll is built for x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Current.Bindings/Current.Bindings.csproj" />
  </ItemGroup>

  <!-- The runner loads the core built with the test engine (build.ps1 passes -p:CoreTestLibDir), in place of the shipped one the class
       library copies in; test.ps1 checks that it did. -->
  <Target Name="UseTestEngineCore" AfterTargets="Build" Condition="'$(CoreTestLibDir)' != ''">
    <Copy SourceFiles="$([MSBuild]::EnsureTrailingSlash('$(CoreTestLibDir)'))current_ffi.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
